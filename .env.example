# ==========================================
# MOAI SCM ERP - Environment Variables
# ==========================================

# 1. Supabase Project Configuration
# Salin dari: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Opsional: Service Role Key (jika ingin akses admin tanpa bypass RLS)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Server Port Configuration (Default: 5000)
PORT=5000

# 3. Frontend API Base URL (Default: /api)
# VITE_API_URL=http://localhost:5000/api
